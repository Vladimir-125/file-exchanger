# HTTP port
PORT=3000
# Where the SQLite database and uploaded files live
DATA_DIR=./data
# Public URL used in emails and links, e.g. https://files.example.com (empty = derive from request)
BASE_URL=
# 64 hex chars, `openssl rand -hex 32`; empty = random per start (sessions reset on restart)
APP_SECRET=
# Behind a reverse proxy: true (one hop), a hop count, or loopback; empty = off
TRUST_PROXY=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Hours a transfer stays downloadable
TRANSFER_TTL_HOURS=24
# Minutes a live (peer-to-peer) key stays valid
LIVE_KEY_TTL_MINUTES=10
# Length of share keys (5-12)
KEY_LENGTH=6
# Largest single file, in MB
MAX_FILE_MB=2000
# Max files in one transfer
MAX_FILES_PER_TRANSFER=20
# Max total size of one transfer, in MB
MAX_TRANSFER_MB=4000
# Total disk budget for stored transfers, in GB (decimals allowed)
STORAGE_CAP_GB=50
# Upload chunk size in MB (max 95, keep under the proxy body limit)
CHUNK_MB=50
# Minutes before an unfinished upload is discarded
UPLOAD_ABANDON_MINUTES=60

# SMTP connection URL for emailing links, e.g. smtps://user:pass@smtp.example.com (empty = email disabled)
SMTP_URL=
# From header for outgoing mail
MAIL_FROM=File Exchanger <no-reply@localhost>

# Optional TURN relay for live transfers (a public STUN server is always included)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
