PORT=3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=fileexchanger
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=fileexchanger

# Gmail account + app password (https://myaccount.google.com/apppasswords)
EMAIL=you@gmail.com
PASSWD=your-app-password

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Public URL used in confirmation emails, e.g. https://files.example.com
BASE_URL=
# Set to true when served over HTTPS (behind a proxy also set TRUST_PROXY=1)
COOKIE_SECURE=false
TRUST_PROXY=
MAX_UPLOAD_MB=100
